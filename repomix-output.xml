                )}

                {/* Footer con totale e azioni */}
                {showFooter && (
                    <div className="px-6 py-5 border-t border-neutral-800 space-y-4">
                        {cartEntries.length > 0 && (
                            <div className="flex items-center justify-between text-sm text-neutral-400">
